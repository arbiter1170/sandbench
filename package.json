{
  "name": "sandbench",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite",
    "harness": "node harness/server.mjs",
    "mcp": "node scripts/mcp-server.mjs",
    "mock-openai": "node scripts/mock-openai-tools.mjs",
    "import-grok": "node scripts/import-grok-desktop.mjs",
    "import-openmaus": "node scripts/import-openmaus-team.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "electron:dev": "node scripts/electron-dev.mjs",
    "electron:pack": "npm run build && electron-builder --win --dir"
  },
  "dependencies": {
    "firebase": "^11.10.0",
    "mermaid": "^11.17.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "^37.10.3",
    "electron-builder": "^26.15.3",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vite-plugin-pwa": "^1.0.3"
  },
  "build": {
    "appId": "local.sandbench.app",
    "productName": "Sandbench",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "harness/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "dir"
      ]
    }
  }
}

# Copy to deploy/.env on the VM and fill in. deploy/.env is git-ignored; never commit it.

# Sandbench's own Firebase project (never haven-57041, ourtime-529bd,
# studio-6245027179-b7f2d or walklings-4cc89).
FIREBASE_PROJECT_ID=
# Public Firebase web config for the page build (Project settings > Your apps).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=

# Comma-separated Google accounts the runner lets in. Checked on the server.
SANDBENCH_ALLOWED_EMAILS=
# The https address the tunnel serves, e.g. https://sandbench.example.com
SANDBENCH_PUBLIC_ORIGIN=

# Long random string, e.g. `openssl rand -hex 24`.
POSTGRES_PASSWORD=
# From Cloudflare Zero Trust > Networks > Tunnels > your tunnel > token.
CLOUDFLARE_TUNNEL_TOKEN=

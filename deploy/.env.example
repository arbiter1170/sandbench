# Copy to deploy/.env on the VM and fill in. deploy/.env is git-ignored; never commit it.

# Sandbench's own Firebase project. Never one of the off-limits projects;
# the runner refuses to start with them (see runner/guard.mjs).
FIREBASE_PROJECT_ID=
# Optional: more Firebase project ids the runner must refuse (comma-separated).
SANDBENCH_BLOCKED_PROJECTS=
# Public Firebase web config for the page build (Project settings > Your apps).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=

# Which way in: "laptop" (Tailscale Funnel) or "cloudflare" (named tunnel, needs a domain).
COMPOSE_PROFILES=laptop

# Comma-separated Google accounts the runner lets in. Checked on the server, and the only
# gate in front of /api when the laptop profile is used (Funnel has no sign-in screen).
SANDBENCH_ALLOWED_EMAILS=
# The runner's own https address, e.g. https://sandbench.your-tailnet.ts.net
# (leave empty on the first start, fill in once Tailscale shows the name).
SANDBENCH_PUBLIC_ORIGIN=
# Other pages allowed to call /api from a browser: exact origins, comma-separated, no
# wildcards. For the laptop: the Vercel production URL, e.g. https://sandbench-ten.vercel.app
SANDBENCH_ALLOWED_ORIGINS=

# Laptop profile: a reusable, tagged auth key from the Tailscale admin console
# (Settings > Keys). TS_HOSTNAME becomes the first part of the ts.net address.
TS_AUTHKEY=
TS_HOSTNAME=sandbench

# Long random string, e.g. `openssl rand -hex 24`.
POSTGRES_PASSWORD=
# Cloudflare profile only: Zero Trust > Networks > Tunnels > your tunnel > token.
CLOUDFLARE_TUNNEL_TOKEN=

# Model and voice keys (SB-05). Set them here, or add them from Settings > Keys, which
# writes /srv/sandbench/secrets.json (0600) on the runner. A value set here wins and
# cannot be changed from the page. The page never sees a value, only a short preview.
XAI_API_KEY=
ANTHROPIC_API_KEY=
COMPAT_API_KEY=
DECISION_API_KEY=
ELEVENLABS_API_KEY=
FISH_API_KEY=
